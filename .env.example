PLAUSIBLE_URL="base url to Plausible Analytics instance"
PLAUSIBLE_SCRIPT_URL="url to Plausible Analytics script"
SENTRY_DSN="Sentry/GlitchTip DSN"
SENTRY_TUNNEL="optional URL that proxies to the GlitchTip envelope endpoint (avoids adblockers)"
SENTRY_ORG="GlitchTip organization slug (for source map uploads)"
SENTRY_PROJECT="GlitchTip project slug (for source map uploads)"
SENTRY_AUTH_TOKEN="GlitchTip API token (for source map uploads)"
